generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum ThoughtType {
  SCENE
  CHARACTER
  QUOTE
  DETAIL
  FEELING
  INTERPRETATION
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  displayName   String
  email         String    @unique
  profileImage  String?
  bio           String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  watchlist         Watchlist[]
  watchedMovies     WatchedMovie[]
  diaryEntries      DiaryEntry[]
  reviews           Review[]
  movieThoughts     MovieThought[]
  interpretations   Interpretation[]
  interpretationResponses InterpretationResponse[]
  discussions       Discussion[]
  discussionResponses DiscussionResponse[]
  tasteProfile      TasteProfile?

  @@index([username])
  @@index([email])
}

model Movie {
  id              String    @id @default(cuid())
  externalId      String    @unique
  title           String
  originalTitle   String?
  overview        String?
  releaseDate     DateTime?
  posterPath      String?
  backdropPath    String?
  runtime         Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  genres            MovieGenre[]
  watchlistEntries  Watchlist[]
  watchedMovies     WatchedMovie[]
  diaryEntries      DiaryEntry[]
  reviews           Review[]
  movieThoughts     MovieThought[]
  interpretations   Interpretation[]
  discussions       Discussion[]

  @@index([externalId])
  @@index([title])
  @@index([releaseDate])
}

model Genre {
  id    String   @id @default(cuid())
  name  String   @unique

  movies MovieGenre[]

  @@index([name])
}

model MovieGenre {
  movieId String
  genreId String

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre Genre @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
}

model WatchedMovie {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  watchedAt DateTime @default(now())
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([userId])
  @@index([movieId])
  @@index([watchedAt])
}

model DiaryEntry {
  id           String     @id @default(cuid())
  userId       String
  movieId      String
  watchedAt    DateTime
  personalNote String?
  visibility   Visibility @default(PRIVATE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([watchedAt])
  @@index([visibility])
}

model Review {
  id         String     @id @default(cuid())
  userId     String
  movieId    String
  content    String
  rating     Float?
  spoiler    Boolean    @default(false)
  visibility Visibility @default(PUBLIC)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([createdAt])
  @@index([visibility])
}

model MovieThought {
  id        String     @id @default(cuid())
  userId    String
  movieId   String
  type      ThoughtType
  content   String
  spoiler   Boolean    @default(false)
  visibility Visibility @default(PUBLIC)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([movieId])
  @@index([type])
  @@index([createdAt])
  @@index([visibility])
}

model Interpretation {
  id          String     @id @default(cuid())
  movieId     String
  userId      String
  title       String
  description String
  spoiler     Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  movie    Movie                    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user     User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses InterpretationResponse[]

  @@index([movieId])
  @@index([userId])
  @@index([createdAt])
}

model InterpretationResponse {
  id              String   @id @default(cuid())
  interpretationId String
  userId          String
  content         String
  spoiler         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  interpretation Interpretation @relation(fields: [interpretationId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([interpretationId])
  @@index([userId])
  @@index([createdAt])
}

model Discussion {
  id        String     @id @default(cuid())
  movieId   String
  userId    String
  title     String
  content   String
  spoiler   Boolean    @default(false)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  movie    Movie               @relation(fields: [movieId], references: [id], onDelete: Cascade)
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses DiscussionResponse[]

  @@index([movieId])
  @@index([userId])
  @@index([createdAt])
}

model DiscussionResponse {
  id           String   @id @default(cuid())
  discussionId String
  userId       String
  content      String
  spoiler      Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([discussionId])
  @@index([userId])
  @@index([createdAt])
}

model TasteProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  preferences  Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}